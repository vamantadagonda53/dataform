config {
  type: "incremental",
  schema: dataform.projectConfig.vars.transformation_target_tenant_dataset,
  name: "timeslots_1h_reservations",
  tags: ["axxerion"],
  uniqueKey: ["timeslot_id"],
  partitionBy: "calendar_date",
  requirePartitionFilter: false,
  onSchemaChange: "SYNCHRONIZE",
  clusterBy: ["location_id", "reservable_id"],
  columns: columns_description.getColumnsDescriptions("timeslots_1h_reservations"),
  labels: {
    layer: "mart_tables",
    domain: "reservations",
    managed_by: "dataform"
  }
}

js {
  const fullReload = columns_description.stringToBoolean(dataform.projectConfig.vars.full_reload);
}

pre_operations {
    ${when(incremental() && fullReload, `
    TRUNCATE TABLE ${self()};  -- noqa: LXR
    `)}

    ${when(incremental() && !fullReload, `
    DELETE FROM ${self()}  -- noqa: LXR
    WHERE calendar_date IN (
        SELECT DISTINCT DATE(slot_start_timestamp) AS calendar_date
        FROM ${ref('IWMS_RESERVATIONS_SLOTS')}
        WHERE res_updatetime >= (
            SELECT COALESCE(MAX(upd_ts), DATETIME('2024-01-01 00:00:00'))
            FROM ${self()} AS tgt, UNNEST(tgt.res_updatetime) AS upd_ts
        )
        UNION DISTINCT
        SELECT DISTINCT calendar_date
        FROM ${self()} AS tgt
        WHERE NOT EXISTS (
            SELECT 1
            FROM ${ref('reservable_locations_calendar')} AS cal
            WHERE cal.timeslot_id = tgt.timeslot_id
        )
        UNION DISTINCT
        SELECT cal_date FROM UNNEST(GENERATE_DATE_ARRAY(
            DATE_ADD(
                COALESCE((SELECT MAX(calendar_date) FROM ${self()}), DATE('2024-01-01')),
                INTERVAL 1 DAY
            ),
            CURRENT_DATE()
        )) AS cal_date
    );
    `)}
}

SELECT
    cal.timeslot_id,
    DATE(cal.slot_start_timestamp) AS calendar_date,
    MOD(EXTRACT(DAYOFWEEK FROM DATE(cal.slot_start_timestamp)) + 5, 7) + 1
        AS day_of_week,
    /*DATETIME(cal.slot_start_timestamp) AS calendar_datetime,*/
   /* DATETIME(
    cal.slot_start_timestamp
    - (
      TIMESTAMP_DIFF(
        TIMESTAMP(DATETIME(cal.slot_start_timestamp, cal.time_zone)),
        cal.slot_start_timestamp,
        SECOND
      ) * INTERVAL 1 SECOND
    )
    ) AS calendar_datetime,*/
        
    DATETIME(
    TIMESTAMP_TRUNC(
        cal.slot_start_timestamp
        - (
        TIMESTAMP_DIFF(
            TIMESTAMP(DATETIME(cal.slot_start_timestamp, cal.time_zone), cal.time_zone),
            cal.slot_start_timestamp,
            SECOND
        ) * INTERVAL 1 SECOND
        ),
        HOUR
    )
    ) AS calendar_datetime,
    /*FORMAT_TIMESTAMP('%Y-%m-%dT%H:%M:%S%z', cal.slot_start_timestamp)
        AS timeslot_start,*/
    CONCAT(
    FORMAT_TIMESTAMP(
             '%Y-%m-%dT%H:00:00',
            TIMESTAMP(
            DATETIME(
            TIMESTAMP_TRUNC(
                cal.slot_start_timestamp
                - (
                TIMESTAMP_DIFF(
                    TIMESTAMP(DATETIME(cal.slot_start_timestamp, cal.time_zone), cal.time_zone),
                    cal.slot_start_timestamp,
                    SECOND
                ) * INTERVAL 1 SECOND
                ),
                HOUR
            )
            ),
            cal.time_zone
             )
            ), FORMAT_TIMESTAMP('%z', cal.slot_start_timestamp, cal.time_zone)
            ) AS timeslot_start,    
    EXTRACT(HOUR FROM DATETIME(cal.slot_start_timestamp)) AS hour_of_day,
    cal.location_id,
    cal.location_class,
    cal.parent_location_id,
    cal.parent_location_class,
    cal.building_id,
    cal.floor_id,
    cal.reservable_id,
    cal.reservable_unique_reference,
    cal.reservable_reference,
    cal.reservable_name,
    cal.reservable_type,
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
        ELSE ARRAY_AGG(
            ARRAY_TO_STRING(
                ARRAY(
                    SELECT CAST(quarter_nr AS STRING)
                    FROM UNNEST([1, 2, 3, 4]) AS quarter_nr
                    WHERE
                        -- Pad zero-width interval (sub-minute reservation collapsed by MINUTE
                        -- truncation) to 1 minute so it lands in the quarter containing its start.
                        (quarter_nr - 1) * 15 < CASE
                            WHEN exp.overlap_start_minute = exp.overlap_end_minute
                                THEN exp.overlap_end_minute + 1
                            ELSE exp.overlap_end_minute
                        END
                        AND quarter_nr * 15 > exp.overlap_start_minute
                    ORDER BY quarter_nr
                ),
                ''
            )
            IGNORE NULLS
            ORDER BY exp.res_starttimestamp, exp.res_id
        )
    END AS quarter_hours,
    -- duration: [0.0] when no reservation; repeated reserved minutes (fractional) per reservation otherwise
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN [CAST(0 AS INT64)]
        ELSE ARRAY_AGG(
            --exp.overlap_duration_minutes
            CAST(exp.overlap_duration_minutes AS INT64)
            IGNORE NULLS
            ORDER BY exp.res_starttimestamp, exp.res_id
        )
    END AS duration,
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<INT64>)
        ELSE ARRAY_AGG(
            exp.res_id IGNORE NULLS ORDER BY exp.res_starttimestamp, exp.res_itemid
        )
    END AS reservation_id,
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
        ELSE ARRAY_AGG(
            exp.reservation_reference
            IGNORE NULLS
            ORDER BY exp.res_starttimestamp, exp.res_itemid
        )
    END AS reservation_reference,
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<INT64>)
        ELSE ARRAY_AGG(
            exp.res_itemid IGNORE NULLS ORDER BY exp.res_starttimestamp, exp.res_itemid
        )
    END AS reservation_item_id,
    CASE
        WHEN COUNTIF(exp.res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
        ELSE ARRAY_AGG(
            exp.reservation_item_nr
            IGNORE NULLS
            ORDER BY exp.res_starttimestamp, exp.res_itemid
        )
    END AS reservation_item_nr,
    ARRAY_AGG(exp.reservation_state IGNORE NULLS ORDER BY exp.res_id) AS reservation_state,
    ARRAY_AGG(exp.res_updatetime IGNORE NULLS ORDER BY exp.res_starttimestamp, exp.res_itemid) AS res_updatetime,
    ARRAY_AGG(CURRENT_TIMESTAMP()) AS creation_timestamp,
    ARRAY_AGG(CURRENT_TIMESTAMP()) AS modification_timestamp
FROM ${ref('reservable_locations_calendar')} AS cal
LEFT JOIN ${ref('IWMS_RESERVATIONS_SLOTS')} AS exp
    ON
        cal.timeslot_id = exp.timeslot_id
        AND exp.is_deleted = 'N'
${when(incremental() && !fullReload, `
WHERE DATE(cal.slot_start_timestamp) IN (
    SELECT DISTINCT DATE(slot_start_timestamp) AS calendar_date
    FROM ${ref('IWMS_RESERVATIONS_SLOTS')}
    WHERE res_updatetime >= (
        SELECT COALESCE(MAX(upd_ts), DATETIME('2024-01-01 00:00:00'))
        FROM ${self()} AS tgt, UNNEST(tgt.res_updatetime) AS upd_ts
    )
    UNION DISTINCT
    SELECT DISTINCT calendar_date
    FROM ${self()} AS tgt
    WHERE NOT EXISTS (
        SELECT 1
        FROM ${ref('reservable_locations_calendar')} AS cal
        WHERE cal.timeslot_id = tgt.timeslot_id
    )
    UNION DISTINCT
    SELECT cal_date FROM UNNEST(GENERATE_DATE_ARRAY(
        DATE_ADD(
            COALESCE((SELECT MAX(calendar_date) FROM ${self()}), DATE('2024-01-01')),
            INTERVAL 1 DAY
        ),
        CURRENT_DATE()
    )) AS cal_date
)
`)}
GROUP BY
    cal.timeslot_id,
    cal.location_id,
    cal.slot_start_timestamp,
    cal.location_class,
    cal.parent_location_id,
    cal.parent_location_class,
    cal.building_id,
    cal.floor_id,
    cal.reservable_id,
    cal.reservable_unique_reference,
    cal.reservable_reference,
    cal.reservable_name,
    cal.reservable_type,
    cal.time_zone
