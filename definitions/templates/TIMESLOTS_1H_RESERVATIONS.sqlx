config {
  type: "incremental",
  schema: dataform.projectConfig.vars.transformation_target_tenant_dataset,
  name: "timeslots_1h_reservations",
  tags: ["axxerion"],
  uniqueKey: ["timeslot_id"],
  //columns: columns_description.getColumnsDescriptions("timeslots_1h_reservations"),
  bigquery: {
    partitionBy: "calendar_date",
    requirePartitionFilter: false,
    clusterBy: ["location_id", "reservable_id"],
    labels: {
      layer: "mart_tables",
      domain: "reservations",
      managed_by: "dataform"
    }
  }
}

js {
  const configuredTestTimestamp = dataform.projectConfig.vars.test_timestamp;
  const configuredLookbackDays = Number(dataform.projectConfig.vars.lookback_days);
  const defaultLookbackDays = Number.isFinite(configuredLookbackDays)
      ? configuredLookbackDays
      : 1;
  const defaultHistoryStartDate = "2024-01-01";
  const runTimestampExpression = configuredTestTimestamp
      ? `SAFE_CAST('${configuredTestTimestamp}' AS TIMESTAMP)`
      : "CURRENT_TIMESTAMP()";
  const historyStartDateExpression = configuredTestTimestamp
      ? `DATE_SUB(DATE(${runTimestampExpression}), INTERVAL 1 DAY)`
      : `DATE('${defaultHistoryStartDate}')`;
}

WITH
    run_metadata AS (
        SELECT ${runTimestampExpression} AS snapshot_timestamp
    ),

    business_settings AS (
        SELECT
            MAX(
                CASE
                    WHEN setting = "cob_rs_startofbusinessday"
                        THEN CASE
                            WHEN REGEXP_CONTAINS(value, r'^\d{2}:\d{2}$')
                                THEN CAST(CONCAT(value, ':00') AS TIME)
                            ELSE CAST(value AS TIME)
                        END
                END
            ) AS business_day_start_hour,
            MAX(
                CASE
                    WHEN setting = "cob_rs_endofbusinessday"
                        THEN CASE
                            WHEN REGEXP_CONTAINS(value, r'^\d{2}:\d{2}$')
                                THEN CAST(CONCAT(value, ':00') AS TIME)
                            ELSE CAST(value AS TIME)
                        END
                END
            ) AS business_day_end_hour
        FROM ${ref('qsdb_tenantsettings')}
    ),

    reservable_locations AS (
        SELECT
            reso.reso_id AS reservable_id,
            reso.reso_unique_reference,
            reso.reso_reference AS reservable_reference,
            reso.reso_name AS reservable_name,
            reso.reso_type AS reservable_type,
            loc.location_id,
            loc.loc_type AS location_class,
            loc.loc_parent_id AS parent_location_id,
            CASE
                WHEN loc.loc_type = 'WORKPLACE' THEN 'ROOM'
                WHEN loc.loc_type IN ('ROOM', 'PARKING') THEN 'FLOOR'
            END AS parent_location_class,
            loc.loc_building_id AS building_id,
            loc.loc_floor_id AS floor_id,
            reso.reso_tz_iana_timezone AS time_zone
        FROM ${ref('IWMS_RESERVABLES')} AS reso
        INNER JOIN ${ref('DIM_LOCATIONS')} AS loc
            ON (
                reso.reso_type = 'ROOM'
                AND reso.reso_objectid = loc.loc_room_id
                AND loc.loc_type = 'ROOM'
            )
            OR (
                reso.reso_type = 'WORKPLACE'
                AND reso.reso_objectid = loc.loc_workplace_id
                AND loc.loc_type = 'WORKPLACE'
            )
            OR (
                reso.reso_type = 'PARKING'
                AND reso.reso_objectid = loc.loc_parking_id
                AND loc.loc_type = 'PARKING'
            )
        WHERE reso.reso_type IN ('ROOM', 'WORKPLACE', 'PARKING')
    ),

${when(incremental(), `
    table_state AS (
        SELECT
            COUNT(*) AS row_count,
            COALESCE(
                MAX(modification_timestamp),
                TIMESTAMP(${historyStartDateExpression})
            ) AS max_modification_timestamp,
            COALESCE(MAX(calendar_date), DATE_SUB(${historyStartDateExpression}, INTERVAL 1 DAY))
                AS max_calendar_date
        FROM ${self()}  -- noqa: LXR
    ),

    existing_timeslots AS (
        SELECT
            timeslot_id,
            MIN(creation_timestamp) AS creation_timestamp
        FROM ${self()}  -- noqa: LXR
        GROUP BY timeslot_id
    ),

    -- All reservation items that have been recently updated (includes deleted/cancelled)
    -- used for change detection only; not filtered by is_deleted or res_result
    reservation_scope AS (
        SELECT
            res.res_itemid,
            res.res_starttimestamp,
            res.res_endtimestamp,
            res.res_updatetime,
            loc.location_id,
            loc.time_zone
        FROM ${ref('IWMS_RESERVATIONS')} AS res
        INNER JOIN reservable_locations AS loc
            ON res.res_itemobjectreference = loc.reso_unique_reference
        WHERE
            res.res_endtimestamp < ${runTimestampExpression}
            AND DATE(res.res_endtimestamp) >= ${historyStartDateExpression}
    ),

    changed_reservations AS (
        SELECT res.*
        FROM reservation_scope AS res
        CROSS JOIN table_state AS st
        WHERE
            st.row_count = 0
            OR DATE(res.res_updatetime) >= DATE_SUB(
                DATE(st.max_modification_timestamp),
                INTERVAL ${defaultLookbackDays} DAY
            )
    ),

    -- Hourly slot positions touched by source-side reservation changes
    impacted_slots_from_source AS (
        SELECT DISTINCT
            res.location_id,
            slot_start_timestamp,
            res.time_zone
        FROM changed_reservations AS res,
        UNNEST(
            GENERATE_TIMESTAMP_ARRAY(
                TIMESTAMP_TRUNC(res.res_starttimestamp, HOUR),
                TIMESTAMP_SUB(res.res_endtimestamp, INTERVAL 1 SECOND),
                INTERVAL 1 HOUR
            )
        ) AS slot_start_timestamp
    ),

    -- Existing timeslot positions in the target that reference changed reservation items
    impacted_slots_from_existing AS (
        SELECT DISTINCT
            tgt.location_id,
            PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%z', tgt.timeslot_start) AS slot_start_timestamp,
            loc.time_zone
        FROM ${self()} AS tgt  -- noqa: LXR
        INNER JOIN reservable_locations AS loc
            ON tgt.location_id = loc.location_id
        CROSS JOIN UNNEST(IFNULL(tgt.reservation_item_id, [])) AS reservation_item_id
        INNER JOIN changed_reservations AS res
            ON reservation_item_id = res.res_itemid
    ),
`, `
    existing_timeslots AS (
        SELECT
            CAST(NULL AS STRING) AS timeslot_id,
            CAST(NULL AS TIMESTAMP) AS creation_timestamp
        WHERE FALSE
    ),
`)}

    -- Only valid past reservations used for slot computation (SRS 3.3 / BI-5355)
    current_valid_reservations AS (
        SELECT
            res.res_id,
            res.res_itemid,
            res.res_userreference AS reservation_reference,
            res.res_itemnr AS reservation_item_nr,
            res.res_starttimestamp,
            res.res_endtimestamp,
            res.res_updatetime,
            loc.location_id,
            loc.time_zone
        FROM ${ref('IWMS_RESERVATIONS')} AS res
        INNER JOIN reservable_locations AS loc
            ON res.res_itemobjectreference = loc.reso_unique_reference
        WHERE
            res.is_deleted = 'N'
            AND res.res_result = 'COMPLETED'
            AND res.res_endtimestamp < ${runTimestampExpression}
            AND DATE(res.res_endtimestamp) >= ${historyStartDateExpression}
    ),

    dense_slot_bounds AS (
        SELECT
            loc.location_id,
            loc.time_zone,
${when(incremental(), `
            CASE
                WHEN st.row_count = 0 THEN ${historyStartDateExpression}
                ELSE DATE_ADD(st.max_calendar_date, INTERVAL 1 DAY)
            END AS start_date,
`, `
            ${historyStartDateExpression} AS start_date,
`)}
            DATE_SUB(DATE(${runTimestampExpression}, loc.time_zone), INTERVAL 1 DAY) AS end_date
        FROM reservable_locations AS loc
${when(incremental(), `        CROSS JOIN table_state AS st`)}
    ),

    new_dense_slots AS (
        SELECT
            bounds.location_id,
            TIMESTAMP(DATETIME(slot_date, TIME(hour_of_day, 0, 0)), bounds.time_zone)
                AS slot_start_timestamp,
            bounds.time_zone
        FROM dense_slot_bounds AS bounds,
        UNNEST(
            IF(
                bounds.start_date <= bounds.end_date,
                GENERATE_DATE_ARRAY(bounds.start_date, bounds.end_date),
                ARRAY<DATE>[]
            )
        ) AS slot_date,
        UNNEST(GENERATE_ARRAY(0, 23)) AS hour_of_day
    ),

    -- All (location, slot_start) positions to compute in this run
    candidate_positions AS (
        SELECT location_id, slot_start_timestamp, time_zone
        FROM new_dense_slots
${when(incremental(), `
        UNION DISTINCT

        SELECT location_id, slot_start_timestamp, time_zone
        FROM impacted_slots_from_source

        UNION DISTINCT

        SELECT location_id, slot_start_timestamp, time_zone
        FROM impacted_slots_from_existing
`)}
    ),

    slot_context AS (
        SELECT
            pos.location_id,
            loc.location_class,
            loc.parent_location_id,
            loc.parent_location_class,
            loc.building_id,
            loc.floor_id,
            loc.reservable_id,
            loc.reso_unique_reference AS reservable_unique_reference,
            loc.reservable_reference,
            loc.reservable_name,
            loc.reservable_type,
            pos.time_zone,
            pos.slot_start_timestamp,
            TIMESTAMP_ADD(pos.slot_start_timestamp, INTERVAL 1 HOUR) AS slot_end_timestamp,
            DATE(DATETIME(pos.slot_start_timestamp, pos.time_zone)) AS calendar_date,
            DATETIME(pos.slot_start_timestamp, pos.time_zone) AS calendar_datetime,
            EXTRACT(HOUR FROM DATETIME(pos.slot_start_timestamp, pos.time_zone)) AS hour_of_day
        FROM candidate_positions AS pos
        INNER JOIN reservable_locations AS loc
            ON pos.location_id = loc.location_id
    ),

    overlapping_reservations AS (
        SELECT
            slot.location_id,
            slot.location_class,
            slot.parent_location_id,
            slot.parent_location_class,
            slot.building_id,
            slot.floor_id,
            slot.reservable_id,
            slot.reservable_unique_reference,
            slot.reservable_reference,
            slot.reservable_name,
            slot.reservable_type,
            slot.time_zone,
            slot.slot_start_timestamp,
            slot.slot_end_timestamp,
            slot.calendar_date,
            slot.calendar_datetime,
            slot.hour_of_day,
            res.res_id,
            res.res_itemid,
            res.reservation_reference,
            res.reservation_item_nr,
            -- Overlap bounds in minutes elapsed from slot start (used for quarter_hours)
            TIMESTAMP_DIFF(
                GREATEST(
                    LEAST(res.res_endtimestamp, slot.slot_end_timestamp),
                    slot.slot_start_timestamp
                ),
                slot.slot_start_timestamp,
                MINUTE
            ) AS overlap_end_minute,
            TIMESTAMP_DIFF(
                LEAST(
                    GREATEST(res.res_starttimestamp, slot.slot_start_timestamp),
                    slot.slot_end_timestamp
                ),
                slot.slot_start_timestamp,
                MINUTE
            ) AS overlap_start_minute,
            TIMESTAMP_DIFF(
                LEAST(res.res_endtimestamp, slot.slot_end_timestamp),
                GREATEST(res.res_starttimestamp, slot.slot_start_timestamp),
                MINUTE
            ) AS overlap_duration_minutes,
            res.res_starttimestamp,
            res.res_itemid AS reservation_item_sort_key
        FROM slot_context AS slot
        LEFT JOIN current_valid_reservations AS res
            ON
                slot.location_id = res.location_id
                AND slot.slot_start_timestamp < res.res_endtimestamp
                AND slot.slot_end_timestamp > res.res_starttimestamp
    ),

    slot_payload AS (
        SELECT
            CONCAT(
                location_id,
                '|',
                FORMAT_TIMESTAMP('%Y-%m-%dT%H:%M:%S%z', slot_start_timestamp, time_zone)
            ) AS timeslot_id,
            calendar_date,
            MOD(EXTRACT(DAYOFWEEK FROM calendar_date) + 5, 7) + 1 AS day_of_week,
            calendar_datetime,
            FORMAT_TIMESTAMP('%Y-%m-%dT%H:%M:%S%z', slot_start_timestamp, time_zone)
                AS timeslot_start,
            hour_of_day,
            location_id,
            location_class,
            parent_location_id,
            parent_location_class,
            building_id,
            floor_id,
            reservable_id,
            reservable_unique_reference,
            reservable_reference,
            reservable_name,
            reservable_type,
            -- quarter_hours: repeated string per reservation showing covered quarter-hours
            -- SRS: 1=00-15, 2=15-30, 3=30-45, 4=45-60; NULL when no reservation in slot
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
                ELSE ARRAY_AGG(
                    ARRAY_TO_STRING(
                        ARRAY(
                            SELECT CAST(quarter_nr AS STRING)
                            FROM UNNEST([1, 2, 3, 4]) AS quarter_nr
                            WHERE
                                (quarter_nr - 1) * 15 < overlap_end_minute
                                AND quarter_nr * 15 > overlap_start_minute
                            ORDER BY quarter_nr
                        ),
                        ''
                    )
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS quarter_hours,
            -- duration: repeated integer (minutes) per reservation; 0 when no reservation
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN [0]
                ELSE ARRAY_AGG(
                    overlap_duration_minutes
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS duration,
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<INT64>)
                ELSE ARRAY_AGG(
                    res_id
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS reservation_id,
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
                ELSE ARRAY_AGG(
                    reservation_reference
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS reservation_reference,
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<INT64>)
                ELSE ARRAY_AGG(
                    res_itemid
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS reservation_item_id,
            CASE
                WHEN COUNTIF(res_id IS NOT NULL) = 0 THEN CAST(NULL AS ARRAY<STRING>)
                ELSE ARRAY_AGG(
                    reservation_item_nr
                    IGNORE NULLS
                    ORDER BY res_starttimestamp, reservation_item_sort_key
                )
            END AS reservation_item_nr,
            settings.business_day_start_hour,
            settings.business_day_end_hour
        FROM overlapping_reservations
        CROSS JOIN business_settings AS settings
        GROUP BY
            location_id,
            location_class,
            parent_location_id,
            parent_location_class,
            building_id,
            floor_id,
            reservable_id,
            reservable_unique_reference,
            reservable_reference,
            reservable_name,
            reservable_type,
            time_zone,
            slot_start_timestamp,
            calendar_date,
            calendar_datetime,
            hour_of_day,
            settings.business_day_start_hour,
            settings.business_day_end_hour
    )

SELECT
    payload.timeslot_id,
    payload.calendar_date,
    payload.day_of_week,
    payload.calendar_datetime,
    payload.timeslot_start,
    payload.hour_of_day,
    payload.location_id,
    payload.location_class,
    payload.parent_location_id,
    payload.parent_location_class,
    payload.building_id,
    payload.floor_id,
    payload.reservable_id,
    payload.reservable_unique_reference,
    payload.reservable_reference,
    payload.reservable_name,
    payload.reservable_type,
    payload.quarter_hours,
    payload.duration,
    payload.reservation_id,
    payload.reservation_reference,
    payload.reservation_item_id,
    payload.reservation_item_nr,
    payload.business_day_start_hour,
    payload.business_day_end_hour,
    COALESCE(
        ${when(incremental(), `existing.creation_timestamp,`)}
        run_metadata.snapshot_timestamp
    ) AS creation_timestamp,
    run_metadata.snapshot_timestamp AS modification_timestamp
FROM slot_payload AS payload
CROSS JOIN run_metadata
${when(incremental(), `LEFT JOIN existing_timeslots AS existing ON payload.timeslot_id = existing.timeslot_id`)}
