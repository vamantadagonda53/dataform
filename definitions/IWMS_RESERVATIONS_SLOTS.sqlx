config {
  type: "incremental",
  schema: dataform.projectConfig.vars.transformation_target_tenant_dataset,
  tags: ["axxerion"],
  uniqueKey: ["res_id", "res_itemid", "slot_start_timestamp"],
  partitionBy: "DATE(slot_start_timestamp)",
  requirePartitionFilter: false,
  clusterBy: ["location_id", "slot_start_timestamp"],
  labels: {
    layer: "intermediate_tables",
    domain: "reservations",
    managed_by: "dataform"
  }
}

SELECT
    res.res_id,
    res.res_itemid,
    res.res_userreference AS reservation_reference,
    res.res_itemnr AS reservation_item_nr,
    loc.location_id,
    loc.location_class,
    loc.parent_location_id,
    loc.parent_location_class,
    loc.building_id,
    loc.floor_id,
    loc.reservable_id,
    loc.reso_unique_reference,
    loc.reservable_reference,
    loc.reservable_name,
    loc.reservable_type,
    slot_start AS slot_start_timestamp,
    loc.time_zone,
    TIMESTAMP_DIFF(
        LEAST(
            GREATEST(res.res_starttimestamp, slot_start),
            TIMESTAMP_ADD(slot_start, INTERVAL 1 HOUR)
        ),
        slot_start,
        MINUTE
    ) AS overlap_start_minute,
    TIMESTAMP_DIFF(
        GREATEST(
            LEAST(res.res_endtimestamp, TIMESTAMP_ADD(slot_start, INTERVAL 1 HOUR)),
            slot_start
        ),
        slot_start,
        MINUTE
    ) AS overlap_end_minute,
    TIMESTAMP_DIFF(
        LEAST(res.res_endtimestamp, TIMESTAMP_ADD(slot_start, INTERVAL 1 HOUR)),
        GREATEST(res.res_starttimestamp, slot_start),
        MINUTE
    ) AS overlap_duration_minutes,
    res.res_starttimestamp,
    res.res_endtimestamp,
    res.res_updatetime,
    CURRENT_TIMESTAMP() AS creation_timestamp,
    CURRENT_TIMESTAMP() AS modification_timestamp
FROM ${ref('IWMS_RESERVATIONS')} AS res
INNER JOIN ${ref('RESERVABLE_LOCATIONS')} AS loc
    ON res.res_itemobjectreference = loc.reso_unique_reference,
    UNNEST(
        GENERATE_TIMESTAMP_ARRAY(
            TIMESTAMP(DATETIME_TRUNC(DATETIME(res.res_starttimestamp, loc.time_zone), HOUR), loc.time_zone),
            TIMESTAMP_SUB(res.res_endtimestamp, INTERVAL 1 SECOND),
            INTERVAL 1 HOUR
        )
    ) AS slot_start
WHERE
    res.is_deleted = 'N'
    AND res.res_result = 'COMPLETED'
    AND res.res_stage = 'H'
    AND res.res_endtimestamp < CURRENT_TIMESTAMP()
    AND DATE(res.res_endtimestamp) >= DATE('2024-01-01')
    ${when(incremental(), `
    AND res.res_updatetime >= (
        SELECT COALESCE(MAX(res_updatetime), DATETIME('2024-01-01 00:00:00'))
        FROM ${self()}  -- noqa: LXR
    )
    `)}
